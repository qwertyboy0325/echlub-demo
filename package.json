{
  "name": "echlub-collaborative-studio-v2",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:browser": "node scripts/validate-browser-load.mjs",
    "validate:shell": "node scripts/capture-shell-evidence.mjs",
    "validate:phase4": "node scripts/capture-phase4-evidence.mjs",
    "validate:phase4:browser": "node scripts/browser-phase4-musical-proof.mjs",
    "validate:phase4:audible": "node scripts/capture-phase4-audible-walkthrough.mjs",
    "validate:phase4:archive": "node scripts/archive-rewrite-comparison.mjs",
    "validate:phase4:safari": "node scripts/browser-safari-phase4-smoke.mjs",
    "validate:private-pack": "node scripts/browser-private-pack-smoke.mjs",
    "promote:public-song": "node scripts/promote-public-song-pack.mjs",
    "collect:live-runtime": "node scripts/collect-live-runtime.mjs",
    "capture:evidence": "node scripts/capture-evidence.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "dockview-react": "^7.0.2",
    "fflate": "^0.8.3",
    "gsap": "3.15.0",
    "interactjs": "^1.10.27",
    "lucide-react": "^1.26.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.1.1",
    "sortablejs": "^1.15.7",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "puppeteer-core": "24.8.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  }
}
